# Copy to .env for local use. Placeholders only — never commit real secrets.

APP_ENV=dev
COMPOSE_PROJECT_NAME=powerwatch

# Postgres
POSTGRES_USER=powerwatch
POSTGRES_PASSWORD=ChangeMe-Postgres-DevOnly
POSTGRES_DB=powerwatch

# Keycloak admin (console)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe-KeycloakAdmin-DevOnly
KEYCLOAK_TEST_USER_PASSWORD=ChangeMe-TestUser-DevOnly!

# Vault (dev mode root token — local only)
VAULT_DEV_ROOT_TOKEN_ID=ChangeMe-VaultRoot-DevOnly
VAULT_ADDR=http://vault:8200

# SNMPv3 simulator placeholders (also loaded into Vault by bootstrap)
SNMP_RO_USER=snmp-ro
SNMP_RO_AUTH_KEY=ChangeMe-SnmpRoAuth-32chars!!
SNMP_RO_PRIV_KEY=ChangeMe-SnmpRoPriv-32chars!!
SNMP_RW_USER=snmp-rw
SNMP_RW_AUTH_KEY=ChangeMe-SnmpRwAuth-32chars!!
SNMP_RW_PRIV_KEY=ChangeMe-SnmpRwPriv-32chars!!

# Public HTTPS hostname served by Caddy
POWERWATCH_HOSTNAME=localhost
